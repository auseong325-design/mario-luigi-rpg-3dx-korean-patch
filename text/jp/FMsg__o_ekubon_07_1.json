  {
   "id": "FMsg/o_ekubon_07_1#13",
   "label": "MES_Ekubon_07_Ekubon_bokosuka_k_30",
   "style": 6,
   "attr": "00000000",
   "jp": "[0009:0000:06 00]よし！[0002:0000:0A 00]\nクッパ[Ruby 城;じょう]へ [Ruby 急;いそ]ぐぞ！！[0002:0001:]"

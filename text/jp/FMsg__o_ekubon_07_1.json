  {
   "id": "FMsg/o_ekubon_07_1#12",
   "label": "MES_Ekubon_07_Ekubon_bokosuka_k_19",
   "style": 6,
   "attr": "00000000",
   "jp": "[0009:0000:06 00]オマエ[Ruby 達;たち] [Ruby 訓練;くんれん]が[Ruby 足;た]りんぞ！[0002:0000:0A 00]\nだから マリオに[Ruby 毎回;まいかい][Ruby 負;ま]けるのだ！！[0002:0001:]"

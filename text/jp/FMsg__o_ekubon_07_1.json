  {
   "id": "FMsg/o_ekubon_07_1#4",
   "label": "MES_Ekubon_07_Ekubon_bokosuka_k_11",
   "style": 6,
   "attr": "00000000",
   "jp": "[0009:0000:06 00][0005:0000:][Ruby 見;み]えないぞ！\nそっち つめろ！[0002:0000:1E 00]"
  },
  {
   "id": "FMsg/o_ekubon_07_1#5",
   "label": "MES_Ekubon_07_Ekubon_bokosuka_k_12",
   "style": 6,
   "attr": "00000000",
   "jp": "[0009:0000:06 00]クッパ[Ruby 様;さま]～[0002:0000:0A 00]\nお[Ruby 助;たす]けください～[0002:0001:]"

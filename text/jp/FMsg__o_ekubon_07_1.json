   "label": "MES_Ekubon_07_Ekubon_bokosuka_k_42",
   "style": 6,
   "attr": "00000000",
   "jp": "[0009:0000:06 00]ここで ゆっくり\nあそんでいくるるよ！！[0002:0001:]"

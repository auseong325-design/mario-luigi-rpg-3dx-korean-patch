  {
   "id": "FMsg/o_ekubon_07_1#11",
   "label": "MES_Ekubon_07_Ekubon_bokosuka_k_18",
   "style": 10,
   "attr": "00000000",
   "jp": "[0009:0000:0A 00][0001:0004:]ガァーーーーー！！[0002:0000:28 00]"

  {
   "id": "FMsg/o_koopa_18_geraexpress_01#17",
   "label": "MES_EV_SKoopa_18_EVSK18_cholopu_08",
   "style": 6,
   "attr": "00000000",
   "jp": "[0009:0000:06 00][0001:0004:]おかげで [Ruby 穴;あな]ほりの[Ruby 仕事;しごと]を\n[Ruby 他;ほか]のやつらに まかせられるように\nなったんだよ！[0002:0001:]"

  {
   "id": "FMsg/o_koopa_end_01#13",
   "label": "MES_EV_MAIN_SKoopa_last_Ending_15",
   "style": 6,
   "attr": "00000000",
   "jp": "[0009:0000:06 00]いらん！[0002:0000:0A 00] こんなもの！！[0002:0001:]"

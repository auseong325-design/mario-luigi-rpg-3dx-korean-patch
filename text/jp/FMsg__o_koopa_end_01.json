  {
   "id": "FMsg/o_koopa_end_01#17",
   "label": "MES_EV_MAIN_SKoopa_last_Ending_19",
   "style": 6,
   "attr": "00000000",
   "jp": "[0009:0000:06 00]クッパ[Ruby 様;さま]～[0002:0000:0A 00]\nごきげんは いかがですか～？[0002:0001:]"

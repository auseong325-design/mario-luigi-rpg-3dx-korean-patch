  {
   "id": "FMsg/o_koopa_end_01#16",
   "label": "MES_EV_MAIN_SKoopa_last_Ending_18",
   "style": 6,
   "attr": "00000000",
   "jp": "[0009:0000:06 00]ひ～[0002:0000:0A 00] こわいこわい…[0002:0001:]"

  {
   "id": "FMsg/o_koopa_end_01#15",
   "label": "MES_EV_MAIN_SKoopa_last_Ending_17",
   "style": 6,
   "attr": "00000000",
   "jp": "[0009:0000:06 00]うるさい！[0002:0000:0A 00] オマエも\nはやく [Ruby 作業;さぎょう]にもどれ！！[0002:0001:]"

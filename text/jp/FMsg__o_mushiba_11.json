  {
   "id": "FMsg/o_mushiba_11#33",
   "label": "MES_EV_Mushiba_11_Mushi_11_koopa_11",
   "style": 6,
   "attr": "00000000",
   "jp": "[0009:0000:06 00][0001:0004:][0001:0001:]その[Ruby 声;こえ]は！！[0002:0001:]"

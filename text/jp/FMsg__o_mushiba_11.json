  {
   "id": "FMsg/o_mushiba_11#35",
   "label": "MES_EV_Mushiba_11_Mushi_11_koopa_12",
   "style": 6,
   "attr": "00000000",
   "jp": "[0009:0000:06 00][0001:0004:][0001:0001:][0005:0000:]ふん！！[0002:0001:]"
  },
  {
   "id": "FMsg/o_mushiba_11#36",
   "label": "MES_EV_Mushiba_11_Mushi_11_koopa_13",
   "style": 6,
   "attr": "00000000",
   "jp": "[0009:0000:06 00][0001:0004:]ジャマをする つもりだろうが\nワガハイを なめるなよ！[0002:0001:]"
  },
  {
   "id": "FMsg/o_mushiba_11#37",
   "label": "MES_EV_Mushiba_11_Mushi_11_koopa_14",
   "style": 10,
   "attr": "00000000",
   "jp": "[0009:0000:0A 00][0001:0004:][0001:0001:][0005:0000:]ガハハハハハハ！！"
  },
  {
   "id": "FMsg/o_mushiba_11#38",
   "label": "MES_EV_Mushiba_11_Mushi_11_koopa_15",
   "style": 6,
   "attr": "00000000",
   "jp": "[0009:0000:06 00][0001:0004:]ちょうど\nひとあばれしたかった ところだ！[0002:0001:]"

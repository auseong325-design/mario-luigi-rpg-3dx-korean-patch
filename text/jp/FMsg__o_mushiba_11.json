  {
   "id": "FMsg/o_mushiba_11#34",
   "label": "MES_Mushiba_11_Mushi_11_koopa_19",
   "style": 6,
   "attr": "00000000",
   "jp": "[0009:0000:06 00][0001:0004:][0001:0001:]なんだ [Ruby 水;みず]か。[0002:0001:]"

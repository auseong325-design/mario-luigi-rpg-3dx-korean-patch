  {
   "id": "FMsg/o_peach_1f_09#21",
   "label": "MES_SPeach_1F_09_SP1F_09_ystar_01",
   "style": 6,
   "attr": "00000000",
   "jp": "[0009:0000:06 00][0001:0004:]ゲラコビッツを\nやっつけたのね。[0002:0001:]"

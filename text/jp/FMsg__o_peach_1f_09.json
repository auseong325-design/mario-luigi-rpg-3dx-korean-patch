  {
   "id": "FMsg/o_peach_1f_09#20",
   "label": "MES_SPeach_1F_09_SP1F_09_koopa_07_2",
   "style": 6,
   "attr": "00000000",
   "jp": "[0009:0000:06 00][0001:0004:][Ruby 悪;わる]い[Ruby 予感;よかん]？[0002:0001:]"
